{
  "name": "krishisetu",
  "version": "1.0.0",
  "description": "KrishiSetu – Farmer Procurement & Payment Management System",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test": "npm run test:server && npm run test:client",
    "db:push": "npm --prefix server run db:push",
    "db:seed": "npm --prefix server run db:seed"
  },
  "keywords": [
    "agriculture",
    "fpc",
    "procurement",
    "offline-first",
    "farmer-payments"
  ],
  "author": "KrishiSetu Team",
  "license": "ISC"
}

