# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL for Production/Supabase/Render, SQLite for local standalone)
DATABASE_URL=postgresql://postgres:password@localhost:5432/krishisetu?schema=public

# Security & Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-change-in-production
JWT_EXPIRES_IN=7d

# Vision AI Configuration (Google Gemini Vision)
# Get a key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here
VISION_PROVIDER=gemini # Options: gemini | mock
GEMINI_MODEL=gemini-3.5-flash-lite # Options: gemini-3.5-flash-lite | gemini-3.5-flash
GEMINI_TIMEOUT_MS=15000

# Anomaly Detection Thresholds
MAX_WEIGHT_MULTIPLIER_BENCHMARK=1.5 # Flag if weight > land_acres * benchmark * multiplier
MIN_PURCHASE_INTERVAL_MINUTES=60 # Flag if same farmer purchases within 60 mins
UNIFORM_MOISTURE_STREAK_THRESHOLD=5 # Flag if >= 5 consecutive purchases have identical moisture

# SMS Gateway Simulation
SMS_GATEWAY_PROVIDER=simulated
SMS_SENDER_ID=KSETU

